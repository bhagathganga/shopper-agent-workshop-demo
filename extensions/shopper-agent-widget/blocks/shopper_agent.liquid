{%- comment -%} assets synced from: plugin_commerce_client 05dd829 2026-10-30, widget 1.50.4 {%- endcomment -%}
{%- comment -%}
  Shopify port of plugin_commerce_client's cimulate/messagingWidgetBody.isml: renders the same
  #cimulate-messaging-widget data-* contract that assets/cimulate-init.js (copied from the cartridge)
  reads. Business Manager cc_config becomes the block settings below; the SFCC session prechat
  handshake is replaced by pre-chat values rendered here into data-routing-attributes.
{%- endcomment -%}
{%- liquid
  assign scrt2_url = block.settings.scrt2_url | strip
  # The SSE stream (/eventrouter/v1/sse) rejects an 18-char org id: X-Org-Id must match the token's 15-char id.
  assign org_id = block.settings.org_id | strip | slice: 0, 15
  assign es_name = block.settings.es_developer_name | strip
  assign cdn = block.settings.cdn_version | strip

  # Pre-chat contract declared on the messaging channel. NA is English + French; anything else is English.
  assign lang = request.locale.iso_code | slice: 0, 2 | downcase
  if lang != 'fr'
    assign lang = 'en'
  endif
  assign country = localization.country.iso_code | default: 'CA'
  assign currency = cart.currency.iso_code | default: localization.country.currency.iso_code
  assign locale = lang | append: '_' | append: country
  assign consent = 'No'
  if customer and customer.accepts_marketing
    assign consent = 'Yes'
  endif

  if lang == 'fr'
    assign fab_label = block.settings.fab_label_fr
  else
    assign fab_label = block.settings.fab_label_en
  endif

  assign is_pdp = false
  assign pdp_id = ''
  if block.settings.enable_page_context and request.page_type == 'product' and product
    assign is_pdp = true
    case block.settings.pdp_id_source
      when 'handle'
        assign pdp_id = product.handle
      when 'variant_sku'
        assign pdp_id = product.selected_or_first_available_variant.sku
      else
        assign pdp_id = product.id
    endcase
  endif

  # Color settings are drops; append forces the hex string before | json.
  assign c_primary = block.settings.primary_color | append: ''
  assign c_on_primary = block.settings.primary_foreground | append: ''
  assign c_surface = block.settings.surface_color | append: ''
  assign c_text = block.settings.text_color | append: ''
  assign font = block.settings.font_family

  assign logo_url = block.settings.logo_url | default: '' | strip
  assign use_menu = false
  if block.settings.launcher_style == 'contact_menu'
    assign use_menu = true
  endif
  if logo_url == blank
    assign logo_url = 'commerce-client-icon.svg' | asset_url
  endif
-%}
{%- capture routing -%}
  {"Language":{{ lang | json }},"CountryCode":{{ country | json }},"Locale":{{ locale | json }},
  "Currency":{{ currency | json }},"ClientVersion":{{ cdn | json }},"isCartMgmtSupported":"false",
  "Consent_Checkbox":{{ consent | json }}
  {%- if customer and block.settings.send_customer -%}
    {%- if customer.first_name != blank -%},"FirstName":{{ customer.first_name | json }}{%- endif -%}
    {%- if customer.last_name != blank -%},"LastName":{{ customer.last_name | json }}{%- endif -%}
    {%- if customer.email != blank -%},"Email":{{ customer.email | json }}{%- endif -%}
    {%- if customer.phone != blank -%},"Phone_Number":{{ customer.phone | json }}{%- endif -%}
  {%- endif -%}}
{%- endcapture -%}
{%- capture theme_json -%}
  {"primaryColor":{{ c_primary | json }},"fontColor":{{ c_text | json }},
  "backgroundColor":{{ c_surface | json }},"fontFamily":{{ font | json }}}
{%- endcapture -%}
{%- capture branding_json -%}
  {"assistantName":{{ block.settings.header_text | json }},"fabLabel":{{ fab_label | json }},
  "theme":{"primary":{{ c_primary | json }},"primaryForeground":{{ c_on_primary | json }},
  "surface":{{ c_surface | json }},"text":{{ c_text | json }},
  "fontFamily":{{ font | json }}}}
{%- endcapture -%}
{%- capture header_json -%}
  {"headerText":{{ block.settings.header_text | json }},"logoUrl":{{ logo_url | json }},
  "headerBackgroundColor":{{ c_surface | json }},"headerTextColor":{{ c_text | json }},
  "headerTextFontWeight":400,"headerTextFontFamily":{{ font | json }},"headerTextTextAlign":"left"}
{%- endcapture -%}

{%- if scrt2_url != blank and org_id != blank and es_name != blank -%}
  {{ 'commerceClient.css' | asset_url | stylesheet_tag }}
  <script src="https://cdn.search.cimulate.ai/copilot-widget/{{ cdn | url_encode }}/messaging.umd.js" defer></script>

  <div
    id="cimulate-messaging-widget"
    data-preset="{{ block.settings.layout_preset | escape }}"
    data-is-dev="{{ block.settings.is_development }}"
    data-is-open="{{ block.settings.is_open }}"
    data-position="{{ block.settings.position | escape }}"
    data-dialog-full-height="true"
    data-page-push="{{ block.settings.page_push }}"
    data-show-fab="{% if use_menu %}false{% else %}true{% endif %}"
    data-is-pdp="{{ is_pdp }}"
    data-pdp-product-id="{{ pdp_id | escape }}"
    data-scrt2-url="{{ scrt2_url | escape }}"
    data-org-id="{{ org_id | escape }}"
    data-es-developer-name="{{ es_name | escape }}"
    data-capabilities-version="{{ block.settings.capabilities_version | escape }}"
    data-enable-page-context="{{ block.settings.enable_page_context }}"
    data-enable-image-upload="false"
    data-enable-escalation="{{ block.settings.enable_escalation }}"
    data-progress-steps-limit="3"
    data-conversation-history-limit="200"
    data-header-text="{{ block.settings.header_text | escape }}"
    data-routing-attributes="{{ routing | strip_newlines | escape }}"
    data-theme="{{ theme_json | strip_newlines | escape }}"
    data-branding-config="{{ branding_json | strip_newlines | escape }}"
    data-header-config="{{ header_json | strip_newlines | escape }}"
  ></div>

  <script src="{{ 'cimulate-init.js' | asset_url }}" defer></script>
  {%- if use_menu -%}
    {%- liquid
      assign text_url = block.settings.text_url | default: '' | strip
      assign whatsapp_url = block.settings.whatsapp_url | default: '' | strip
      assign facebook_url = block.settings.facebook_url | default: '' | strip
      assign call_url = block.settings.call_url | default: '' | strip
      assign new_tab = 'contact_menu.new_tab' | t
    -%}
    {%- capture chevron -%}<svg class="cg-contact-chevron" viewBox="0 0 8 8" aria-hidden="true"><path d="M2 0l4 4-4 4z" fill="currentColor"/></svg>{%- endcapture -%}
    {{ 'cg-contact-menu.css' | asset_url | stylesheet_tag }}
    <div id="cg-contact">
      <button type="button" class="cg-contact-launcher" aria-haspopup="dialog" aria-expanded="false" aria-controls="cg-contact-menu">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 4h18v13H8l-5 4z"/></svg>
        {{ 'contact_menu.launcher' | t }}
      </button>
      <div id="cg-contact-menu" class="cg-contact-menu" role="dialog" aria-labelledby="cg-contact-title" hidden>
        <div class="cg-contact-head">
          <h2 id="cg-contact-title" class="cg-contact-title">{{ 'contact_menu.title' | t }}</h2>
          <button type="button" class="cg-contact-minimize" aria-label="{{ 'contact_menu.minimize' | t | escape }}">&#8212;</button>
        </div>
        <p class="cg-contact-welcome">{{ 'contact_menu.welcome' | t }}</p>
        <ul class="cg-contact-list">
          <li>
            <button type="button" class="cg-contact-option" data-cg-action="chat">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 4h18v13H8l-5 4z"/></svg>
              <span class="cg-contact-label">{{ 'contact_menu.chat' | t }}</span>{{ chevron }}
            </button>
          </li>
          {%- if text_url != blank -%}
            <li>
              <a class="cg-contact-option" href="{{ text_url | escape }}">
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14"/><path d="M3 6l9 7 9-7"/></svg>
                <span class="cg-contact-label">{{ 'contact_menu.text' | t }}</span>{{ chevron }}
              </a>
            </li>
          {%- endif -%}
          {%- if whatsapp_url != blank -%}
            <li>
              <a class="cg-contact-option" href="{{ whatsapp_url | escape }}" target="_blank" rel="noopener" aria-label="{{ 'contact_menu.whatsapp' | t | escape }}, {{ new_tab | escape }}">
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 20l1.2-3.6A8.5 8.5 0 1 1 8 19z"/><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.5-2-1-1 .8a4.5 4.5 0 0 1-2.3-2.3l.8-1-1-2z"/></svg>
                <span class="cg-contact-label">{{ 'contact_menu.whatsapp' | t }}</span>{{ chevron }}
              </a>
            </li>
          {%- endif -%}
          {%- if facebook_url != blank -%}
            <li>
              <a class="cg-contact-option" href="{{ facebook_url | escape }}" target="_blank" rel="noopener" aria-label="{{ 'contact_menu.facebook' | t | escape }}, {{ new_tab | escape }}">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2C6.5 2 2 6.1 2 11.3c0 2.9 1.4 5.5 3.7 7.2V22l3.4-1.9c.9.3 1.9.4 2.9.4 5.5 0 10-4.1 10-9.2S17.5 2 12 2zm1 12.4l-2.6-2.7-5 2.7 5.5-5.8 2.6 2.7 5-2.7z"/></svg>
                <span class="cg-contact-label">{{ 'contact_menu.facebook' | t }}</span>{{ chevron }}
              </a>
            </li>
          {%- endif -%}
          {%- if call_url != blank -%}
            <li>
              <a class="cg-contact-option" href="{{ call_url | escape }}">
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2z"/></svg>
                <span class="cg-contact-label">{{ 'contact_menu.call' | t }}</span>{{ chevron }}
              </a>
            </li>
          {%- endif -%}
        </ul>
      </div>
    </div>
    <script src="{{ 'cg-contact-menu.js' | asset_url }}" defer></script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Shopper Agent chat",
  "target": "body",
  "settings": [
    { "type": "header", "content": "Connection (Embedded Service Deployment)" },
    {
      "type": "text",
      "id": "scrt2_url",
      "label": "SCRT2 URL",
      "default": "https://canadagoose--uat.sandbox.my.salesforce-scrt.com"
    },
    {
      "type": "text",
      "id": "org_id",
      "label": "Salesforce org ID",
      "info": "15 or 18 characters; only the first 15 are sent.",
      "default": "00DRu00000G523O"
    },
    {
      "type": "text",
      "id": "es_developer_name",
      "label": "Embedded Service developer name",
      "default": "Canada_Goose_Shopper_Agent_CC_ES"
    },
    {
      "type": "text",
      "id": "cdn_version",
      "label": "Widget version",
      "default": "1.50.4"
    },
    {
      "type": "text",
      "id": "capabilities_version",
      "label": "Capabilities version",
      "default": "65"
    },
    { "type": "header", "content": "Launcher" },
    {
      "type": "select",
      "id": "launcher_style",
      "label": "Chat launcher",
      "options": [
        { "value": "contact_menu", "label": "Customer Support menu (canadagoose.com)" },
        { "value": "widget_button", "label": "Widget chat button" }
      ],
      "default": "contact_menu"
    },
    {
      "type": "text",
      "id": "text_url",
      "label": "Text us link",
      "info": "e.g. sms:+1... Leave blank to hide the option.",
      "default": "sms:+18339974728"
    },
    {
      "type": "text",
      "id": "whatsapp_url",
      "label": "WhatsApp link",
      "info": "Leave blank to hide the option.",
      "default": "https://api.whatsapp.com/send/?phone=18339974728&text&type=phone_number&app_absent=0"
    },
    {
      "type": "text",
      "id": "facebook_url",
      "label": "Facebook Messenger link",
      "info": "Leave blank to hide the option.",
      "default": "https://m.me/canadagoose"
    },
    {
      "type": "text",
      "id": "call_url",
      "label": "Call us link",
      "info": "e.g. tel:+1... or a contact page URL. Leave blank to hide the option.",
      "default": "tel:+18339974728"
    },
    { "type": "header", "content": "Behavior" },
    {
      "type": "checkbox",
      "id": "enable_escalation",
      "label": "Show 'Connect to a human agent' button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "send_customer",
      "label": "Send signed-in customer's name, email and phone as pre-chat fields",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_page_context",
      "label": "Send the current product on product pages",
      "default": false
    },
    {
      "type": "select",
      "id": "pdp_id_source",
      "label": "Product identifier sent on product pages",
      "options": [
        { "value": "product_id", "label": "Shopify product ID" },
        { "value": "handle", "label": "Product handle" },
        { "value": "variant_sku", "label": "Selected variant SKU" }
      ],
      "default": "product_id"
    },
    {
      "type": "checkbox",
      "id": "is_open",
      "label": "Open the chat on page load",
      "default": false
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        { "value": "bottom-right", "label": "Bottom right" },
        { "value": "bottom-left", "label": "Bottom left" }
      ],
      "default": "bottom-right"
    },
    {
      "type": "select",
      "id": "layout_preset",
      "label": "Layout",
      "options": [
        { "value": "standard", "label": "Standard" },
        { "value": "commerce", "label": "Commerce" }
      ],
      "default": "standard"
    },
    {
      "type": "checkbox",
      "id": "page_push",
      "label": "Push page content aside when the panel is open (desktop)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "is_development",
      "label": "Widget development mode",
      "default": false
    },
    { "type": "header", "content": "Branding" },
    {
      "type": "text",
      "id": "header_text",
      "label": "Panel title",
      "default": "Canada Goose"
    },
    {
      "type": "text",
      "id": "fab_label_en",
      "label": "Chat button label (English)",
      "default": "Chat with us"
    },
    {
      "type": "text",
      "id": "fab_label_fr",
      "label": "Chat button label (French)",
      "default": "Clavarder avec nous"
    },
    {
      "type": "text",
      "id": "logo_url",
      "label": "Header logo URL (https)",
      "info": "Leave blank for the default icon."
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "primary_foreground",
      "label": "Text on primary",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "surface_color",
      "label": "Panel background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#181818"
    },
    {
      "type": "text",
      "id": "font_family",
      "label": "Font family",
      "default": "Arial, sans-serif"
    }
  ]
}
{% endschema %}
